# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR MULTI-INSTITUTE PORTAL
# ==============================================================================

# Public Supabase Client (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-new-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-Side Only - Used for Global Admin & Queue workers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Supavisor Transaction Pooler (Port 6543) - For Serverless Scaled Execution
# Example: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Optional Cron Secret for automated ping / worker triggers
CRON_SECRET=your_super_secret_cron_token_here

# Support Email (Displayed on quota warnings and upgrade contacts)
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourportal.com
